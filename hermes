#!/usr/bin/env bash
# hermes — config backup & restore with a fuzzy picker UI
# https://github.com/19Naveen/Hermes
# entrypoint only — logic lives in lib/

set -euo pipefail
printf '\033]0;HERMES\007'

SELF="$(readlink -f "$0")"
LIB="${HERMES_LIB:-$(dirname "$SELF")/../share/hermes/lib}"
[[ -d $LIB ]] || LIB="$(dirname "$SELF")/lib"
[[ -d $LIB ]] || { echo "hermes: lib not found at $LIB" >&2; exit 1; }

for f in common discover backup install extra; do
  # shellcheck source=/dev/null
  source "$LIB/$f.sh"
done

case "${1:-help}" in
  backup)     do_backup ;;
  install)    do_install ;;
  list)       do_list ;;
  remote)     do_remote "$@" ;;
  secret)     do_secret "$@" ;;
  completion)
    # auto-install completions when run without piped output, else print
    if [[ -t 1 ]] && [[ -z "${2:-}" ]]; then
      mkdir -p ~/.zsh/completions
      do_completion > ~/.zsh/completions/_hermes
      if [[ -f ~/.zshrc ]] && ! grep -qs '.zsh/completions' ~/.zshrc; then
        if grep -q 'compinit' ~/.zshrc; then
          sed -i 's|^\(.*compinit.*\)$|fpath=(~/.zsh/completions $fpath)\n\1|' ~/.zshrc
        else
          echo 'fpath=(~/.zsh/completions $fpath)' >> ~/.zshrc
        fi
      fi
      ok "zsh completions installed to ~/.zsh/completions/_hermes"
      echo "  restart zsh or run: compinit"
    else
      do_completion
    fi
    ;;
  update)     do_update ;;
  help|--help|-h) usage ;;
  *)          usage ;;
esac
